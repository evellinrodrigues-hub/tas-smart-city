# Copie para .env e ajuste. O .env NAO e versionado (ver .gitignore):
# segredo versionado permanece no historico mesmo depois de apagado, e isso e
# incidente de seguranca, nao deslize de organizacao.
#
#   cp .env.example .env
#
# Nenhuma variavel abaixo e lida automaticamente por arquivo: passe-as no
# ambiente do comando, por exemplo
#   BASE_URL=http://localhost:5000 npm test

# ---------------------------------------------------------------------------
# Alvo
# ---------------------------------------------------------------------------

# Endereco do SUT. Trocar de alvo e mudar ESTA linha, e nenhum arquivo de teste.
#   duplo de referencia do contrato (local) : http://localhost:5000
#   back-end Flask do Projeto Integrador    : http://localhost:5000
#   ambiente de teste da squad              : https://<host-da-squad>
BASE_URL=http://localhost:5000

# Prefixos das rotas. Ajuste se o back-end versionar a API (ex.: /api/v1).
PREFIXO_AUTH=/auth
PREFIXO_API=/api

# Tempo maximo de espera por resposta, em milissegundos.
TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Usuarios de teste
# ---------------------------------------------------------------------------
# Precisam existir no alvo, com os perfis indicados. Contra o back-end real,
# crie-os na massa do ambiente de teste antes da primeira execucao.

USUARIO_CIDADAO=ana@exemplo.com
USUARIO_CIDADAO_2=bruno@exemplo.com
USUARIO_GESTOR=gestor@exemplo.com
USUARIO_ADMIN=admin@exemplo.com

# Senha unica para todos os usuarios de teste. Contra o back-end real, use
# SENHA_CIDADAO / SENHA_GESTOR / SENHA_ADMIN se elas forem diferentes.
SENHA_PADRAO=senha123

# ---------------------------------------------------------------------------
# Verificacao de sensibilidade
# ---------------------------------------------------------------------------

# Porta usada pelo duplo de referencia durante `npm run sensibilidade`.
PORTA_SENSIBILIDADE=5099
